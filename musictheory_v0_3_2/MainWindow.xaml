<Window x:Class="musictheory_v0_3_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:musictheory_v0_3_2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing"
        >
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ComboBox x:Name="MidiInComboBox"
                      Margin="5"/>
            <ComboBox x:Name="MidiColorOutComboBox"
                      Margin="5"/>
            <Button Content="Refresh MIDI options"
                    Width="180" Height="40" Margin="5"
                    Click="RefreshButton_Click"/>
            <Button Content="MIDI start / autoselect"
                    Width="180" Height="40" Margin="5"
                    Click="InitializeMidiButton_Click"/>
            <Button Content="Play Sound" 
                    Width="180" Height="40" Margin="5"
                    Click="PlaySoundButton_Click"/>
            <Button Content="Stop Sound" 
                    Width="180" Height="40" Margin="5"
                    Click="StopSoundButton_Click"/>
            <Button Content="Device Manager" 
                    Width="180" Height="40" Margin="5"
                    Click="DeviceManagerOpeningButton_Click"/>
        </StackPanel>
    </Grid>
</Window>